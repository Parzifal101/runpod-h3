# runpod-h3 settings. Edit, then `bash start.sh` again.

# Web UI port (must be listed in the pod's "Expose HTTP ports")
PORT=7860

# WanGP version: a commit hash or tag. Empty = latest main.
# v19.02 was tested on 2026-11-02 with RTX 5090 + torch 2.10/cu130.
WANGP_REF=

# mmgp memory profile: 4 = LowRAM_LowVRAM (tested), 5 = VeryLowRAM (slower, much less RAM)
PROFILE=4

# Attention backend: empty = WanGP auto (sdpa unless sage is installed)
ATTENTION=

# mem_guard restarts WanGP between jobs when process memory exceeds this (container limit on 5090 pods ~99 GB)
MEM_GUARD_GB=88

# PyTorch build. cu130 needs a host driver with CUDA 13.x (filter by CUDA version when creating the pod).
# Fallback if CUDA 13 hosts misbehave: "torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0" + .../whl/cu128
TORCH_SPEC="torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0"
TORCH_INDEX=https://download.pytorch.org/whl/cu130

# Extra raw flags for wgp.py
EXTRA_ARGS=
